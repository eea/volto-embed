{
  "name": "@eeacms/volto-embed",
  "version": "11.0.6",
  "description": "Embed external content",
  "main": "src/index.js",
  "author": "European Environment Agency: IDM2 A-Team",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/eea/volto-embed",
  "keywords": [
    "volto-addon",
    "volto-block",
    "volto-grid",
    "volto",
    "plone",
    "react"
  ],
  "addons": [
    "@eeacms/volto-corsproxy",
    "@eeacms/volto-datablocks"
  ],
  "dependencies": {
    "@eeacms/volto-corsproxy": "*",
    "@eeacms/volto-datablocks": "*"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.10.0",
    "@plone/scripts": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "cypress": "13.1.0",
    "cypress-fail-fast": "^5.0.1",
    "dotenv": "^16.3.2",
    "husky": "^8.0.3",
    "jsdom": "23.0.0",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "@plone/registry": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "redux-mock-store": "1.5.4",
    "redux-thunk": "^2.4.2",
    "release-it": "^19.0.5",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "make lint-fix",
      "make prettier-fix"
    ],
    "src/**/*.{jsx}": [
      "make i18n"
    ],
    "theme/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "src/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "theme/**/*.overrides": [
      "make stylelint-fix"
    ],
    "src/**/*.overrides": [
      "make stylelint-fix"
    ]
  },
  "scripts": {
    "prepare": "cd ../.. && husky install || true",
    "release": "release-it",
    "release-major-beta": "release-it major --preRelease=beta",
    "release-beta": "release-it --preRelease=beta",
    "test": "vitest --config ./vitest.config.mjs run --passWithNoTests",
    "test:fix": "vitest --config ./vitest.config.mjs run --passWithNoTests --update",
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "dry-release": "release-it --dry-run",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
